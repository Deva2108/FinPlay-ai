# =============================================================================
# FinPlay environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# ---------- Spring profile ----------
SPRING_PROFILES_ACTIVE=prod

# ---------- Database (PostgreSQL) ----------
POSTGRES_DB=stocksdb
DB_USERNAME=postgres
DB_PASSWORD=changeme_strong_password
# DB_URL is computed automatically inside docker-compose from the values above.
# Only set DB_URL manually if you point the backend at an external Postgres
# (e.g. Neon: jdbc:postgresql://<host>/<db>?sslmode=require).
# DB_URL=jdbc:postgresql://db:5432/stocksdb

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379

# ---------- Auth ----------
# Generate a real one: openssl rand -base64 64
JWT_SECRET=replace_me_with_a_64_char_random_string
JWT_EXPIRATION=86400000

# ---------- Market data APIs (mandatory) ----------
FINNHUB_API_KEY=your_finnhub_key
NEWS_API_KEY=your_newsapi_key

# ---------- Market data APIs (optional fallback) ----------
ALPHA_VANTAGE_KEY=

# ---------- AI ----------
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=

# ---------- Content (optional) ----------
YOUTUBE_API_KEY=

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Frontend build ----------
# What the React app uses to call the backend.
# Local Docker:  http://localhost:8080
# Vercel prod:   https://your-app.onrender.com
VITE_API_URL=http://localhost:8080

# ---------- Admin ----------
# Comma-separated emails. Anyone in this list logs in with ROLE_ADMIN.
# Leave empty in dev; set to your real email in prod (Render env).
ADMIN_EMAILS=devanshdubey2108@gmail.com

# ---------- Misc ----------
SWAGGER_ENABLED=true
FINPLAY_STARTING_BALANCE=100000
