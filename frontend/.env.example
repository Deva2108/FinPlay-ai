# =============================================================================
# FinPlay Frontend env vars
#
# LOCAL DEV:
#   Copy this file to `.env.local` and adjust as needed. `.env.local` is
#   gitignored by Vite by default and will NOT be committed.
#
# PRODUCTION (Vercel):
#   Set VITE_API_URL on the Vercel dashboard under
#   Settings → Environment Variables. Apply it to:
#     - Production
#     - Preview
#     - Development
#   If you only set it for "Production", every PR preview will silently
#   call localhost and break. The app will display a red banner if this
#   var is missing in a production build (see `services/api.js`).
# =============================================================================

# Backend base URL. No trailing slash.
# Local:     http://localhost:8080
# Render:    https://your-app-name.onrender.com
VITE_API_URL=http://localhost:8080
